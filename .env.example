# ==============================================================================
# OCRATION - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# OCR.Space API Key (Get a free key from: https://ocr.space/ocrapi)
OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# Groq Cloud API Key (Get a free fast inference key from: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Default OCR Language (e.g. eng, ara, fre, ger, spa)
OCR_SPACE_LANGUAGE=eng

# Optional: Flask Server Port (Default: 5000)
FLASK_PORT=5000

# Optional: App Environment (development / production)
FLASK_ENV=development
